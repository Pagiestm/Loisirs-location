{# templates/form/tailwind_theme.html.twig #}

{# =========================
   LABEL
========================= #}
{% block form_label -%}
    {% if label is not same as(false) -%}
        {% if required -%}
            {% set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' required')|trim}) %}
        {% endif %}

        {% if label is empty -%}
            {% if label_format is not empty -%}
                {% set label = label_format|replace({
                    '%name%': name,
                    '%id%': id,
                }) %}
            {% else %}
                {% set label = name|humanize %}
            {% endif %}
        {% endif %}

        <label
            {% if label_attr %}{% with { attr: label_attr } %}{{ block('attributes') }}{% endwith %}{% endif %}
            class="block text-sm font-medium text-gray-700"
        >
            {{ translation_domain is same as(false)
                ? label
                : label|trans(label_translation_parameters, translation_domain) }}

            {% if required %}
                <span class="text-red-500">*</span>
            {% endif %}
        </label>
    {% endif %}
{%- endblock form_label %}

{# =========================
   INPUT SIMPLE
========================= #}
{% block form_widget_simple -%}
    {% set type = type|default('text') %}

    {% set attr = attr|merge({
        class: (attr.class|default('') ~ '
            w-full px-4 py-2
            border border-gray-300 rounded-lg
            bg-white shadow-sm
            text-gray-700
            focus:ring-2 focus:ring-primary/40 focus:border-primary
            transition
        ')|trim
    }) %}

    <input type="{{ type }}" {{ block('widget_attributes') }}
        {% if value is not empty %}value="{{ value }}"{% endif %}/>
{%- endblock form_widget_simple %}

{# =========================
   DATE
========================= #}
{% block date_widget -%}
    {% if widget == 'single_text' -%}
        {% set type = type|default('date') %}

        {% set attr = attr|merge({
            class: (attr.class|default('') ~ '
                w-full px-4 py-2
                border border-gray-300 rounded-lg
                bg-white shadow-sm
                text-gray-700
                focus:ring-2 focus:ring-primary/40 focus:border-primary
                transition
            ')|trim
        }) %}

        <input type="{{ type }}" {{ block('widget_attributes') }}
            {% if value is not empty %}value="{{ value }}"{% endif %}/>
    {% else %}
        <div {{ block('widget_container_attributes') }} class="flex gap-2">

            {{ date_pattern|replace({
                '{{ year }}': form_widget(form.year, {
                    attr: { class: '
                        w-full px-4 py-2
                        border border-gray-300 rounded-lg
                        bg-white shadow-sm
                        text-gray-700
                        focus:ring-2 focus:ring-primary/40 focus:border-primary
                        transition
                    ' }
                }),
                '{{ month }}': form_widget(form.month, {
                    attr: { class: '
                        w-full px-4 py-2
                        border border-gray-300 rounded-lg
                        bg-white shadow-sm
                        text-gray-700
                        focus:ring-2 focus:ring-primary/40 focus:border-primary
                        transition
                    ' }
                }),
                '{{ day }}': form_widget(form.day, {
                    attr: { class: '
                        w-full px-4 py-2
                        border border-gray-300 rounded-lg
                        bg-white shadow-sm
                        text-gray-700
                        focus:ring-2 focus:ring-primary/40 focus:border-primary
                        transition
                    ' }
                }),
            })|raw }}

        </div>
    {% endif %}
{%- endblock date_widget %}

{# =========================
   TEL / OTP
========================= #}
{% block tel_widget -%}
    <div data-controller="tel" class="w-full">

        <input type="hidden"
               {{ block('widget_attributes') }}
               data-tel-target="hidden"
               {% if value is not empty %}value="{{ value }}"{% endif %}/>

        <input type="tel"
               inputmode="tel"
               autocomplete="tel"
               placeholder="06 12 34 56 78"
               class="
                    w-full px-4 py-2
                    border border-gray-300 rounded-lg
                    bg-white shadow-sm
                    text-gray-700
                    focus:ring-2 focus:ring-primary/40 focus:border-primary
                    transition
               "
               data-tel-target="input"
               data-action="input->tel#onInput"
               {% if value is not empty %}value="{{ value }}"{% endif %}/>
    </div>
{%- endblock tel_widget %}

{# =========================
   TEXTAREA
========================= #}
{% block textarea_widget -%}
    {% set attr = attr|merge({
        class: (attr.class|default('') ~ '
            w-full px-4 py-2
            border border-gray-300 rounded-lg
            bg-white shadow-sm
            text-gray-700
            focus:ring-2 focus:ring-primary/40 focus:border-primary
            transition
        ')|trim
    }) %}

    <textarea {{ block('widget_attributes') }}>{{ value }}</textarea>
{%- endblock textarea_widget %}

{# =========================
   CHECKBOX
========================= #}
{% block checkbox_widget -%}
    {% set attr = attr|merge({
        class: (attr.class|default('') ~ '
            h-5 w-5
            text-primary
            border-gray-300 rounded
            focus:ring-2 focus:ring-primary/40
            shadow-sm
        ')|trim
    }) %}

    <input type="checkbox"
           {{ block('widget_attributes') }}
           {% if value is defined %}value="{{ value }}"{% endif %}
           {% if checked %}checked="checked"{% endif %}/>
{%- endblock checkbox_widget %}

{# =========================
   RADIO
========================= #}
{% block radio_widget -%}
    {% set attr = attr|merge({
        class: (attr.class|default('') ~ '
            h-5 w-5
            text-primary
            border-gray-300
            focus:ring-2 focus:ring-primary/40
            shadow-sm
        ')|trim
    }) %}

    <input type="radio"
           {{ block('widget_attributes') }}
           {% if value is defined %}value="{{ value }}"{% endif %}
           {% if checked %}checked="checked"{% endif %}/>
{%- endblock radio_widget %}

{# =========================
   SELECT
========================= #}
{% block choice_widget_collapsed -%}
    {% set attr = attr|merge({
        class: (attr.class|default('') ~ '
            w-full px-4 py-2
            border border-gray-300 rounded-lg
            bg-white shadow-sm
            text-gray-700
            focus:ring-2 focus:ring-primary/40 focus:border-primary
            transition
            appearance-none
        ')|trim
    }) %}

    <select {{ block('widget_attributes') }}{% if multiple %} multiple="multiple"{% endif %}>

        {% if placeholder is not none -%}
            <option value=""
                {% if required and value is empty %}selected="selected"{% endif %}>
                {{ placeholder != '' ? (translation_domain is same as(false)
                    ? placeholder
                    : placeholder|trans({}, translation_domain)) }}
            </option>
        {% endif %}

        {% set options = choices %}
        {{ block('choice_widget_options') }}

    </select>
{%- endblock choice_widget_collapsed %}

{# =========================
   ERRORS
========================= #}
{% block form_errors -%}
    {% if errors|length > 0 %}
        <ul class="mt-2 text-sm text-red-600">
            {% for error in errors %}
                <li>{{ error.message }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{%- endblock form_errors %}

{# =========================
   FORM ROW
========================= #}
{% block form_row -%}
    {% set widget_attr = {} %}

    {% if help is not empty %}
        {% set widget_attr = {attr: {'aria-describedby': id ~ "_help"}} %}
    {% endif %}

    <div class="mb-4">

        {# LABEL (inchangé) #}
        {{ form_label(form) }}

        {# WIDGET #}
        {{ form_widget(form, widget_attr) }}

        {# HELP (inchangé) #}
        {{ form_help(form) }}

        {# ERREURS FORCÉES #}
        {% if errors|length > 0 %}
            <ul class="mt-2 text-sm text-red-600">
                {% for error in errors %}
                    <li>{{ error.message }}</li>
                {% endfor %}
            </ul>
        {% endif %}

    </div>
{%- endblock form_row %}

{% block choice_widget_expanded %}
    <div {{ block('widget_container_attributes') }} class="space-y-3 mt-2">
        {% for child in form %}
            <label class="flex items-center gap-2 cursor-pointer">
                {{ form_widget(child) }}
                <span class="text-sm text-gray-700">
                    {{ child.vars.label }}
                </span>
            </label>
        {% endfor %}
    </div>
{% endblock %}

{% block checkbox_row %}
    <div class="mb-4 flex items-center gap-2">

        {{ form_widget(form) }}

        {{ form_label(form, null, {
            label_attr: {
                class: 'text-sm text-gray-700 cursor-pointer'
            }
        }) }}

        {{ form_errors(form) }}

    </div>
{% endblock %}

{# =========================
   PASSWORD ROW
========================= #}
{% block password_row -%}
    {% set widget_attr = {} %}

    {% if help is not empty %}
        {% set widget_attr = {attr: {'aria-describedby': id ~ "_help"}} %}
    {% endif %}

    <div data-controller="password" class="mb-4">

        {# HEADER (label + toggle) #}
        <div class="flex items-center justify-between mb-1">

            {{ form_label(form) }}

            <button
                data-live-ignore
                type="button"
                data-action="click->password#toggle"
                class="flex items-center gap-1.5 px-2 py-1 text-xs text-gray-600
                       hover:text-gray-900 transition-colors focus:outline-none"
            >
                <twig:ux:icon
                    name="lucide:eye"
                    class="w-4 h-4"
                    data-password-target="iconShow"
                />

                <twig:ux:icon
                    name="lucide:eye-off"
                    class="w-4 h-4 hidden"
                    data-password-target="iconHide"
                />

                <span data-password-target="text">
                    Montrer
                </span>
            </button>

        </div>

        {# INPUT #}
        {{ form_widget(form, widget_attr) }}

        {# ERRORS #}
        {{ form_errors(form) }}

        {# HELP #}
        {{ form_help(form) }}

    </div>
{%- endblock password_row %}

{% block password_widget -%}
    {% set attr = attr|merge({
        class: (attr.class|default('') ~ '
            w-full px-4 py-2
            border border-gray-300 rounded-lg
            bg-white shadow-sm
            text-gray-700
            focus:ring-2 focus:ring-primary/40 focus:border-primary
            transition
        ')|trim
    }) %}

    <input type="password"
           data-password-target="input"
           {{ block('widget_attributes') }}
           {% if value is not empty %}value="{{ value }}"{% endif %}/>
{%- endblock password_widget %}

{# =========================
   HELP
========================= #}
{% block form_help -%}
    {% if help is not empty %}
        <p class="mt-1 text-sm text-gray-500">
            {{ translation_domain is same as(false)
                ? help
                : help|trans(help_translation_parameters, translation_domain) }}
        </p>
    {% endif %}
{%- endblock form_help %}

{# =========================
   BUTTON
========================= #}
{% block button_widget -%}
    {% set attr = attr|merge({
        class: (attr.class|default('') ~ '
            bg-primary text-white
            py-3 px-6 rounded-lg
            font-medium
            hover:bg-primary/90
            transition
        ')|trim
    }) %}

    <button type="{{ type|default('button') }}" {{ block('button_attributes') }}>
        {{ label }}
    </button>
{%- endblock button_widget %}

{# =========================
   SUBMIT
========================= #}
{% block submit_widget -%}
    {% set attr = attr|merge({
        class: (attr.class|default('') ~ '
            w-full bg-primary text-white
            py-3 rounded-lg
            font-medium
            hover:bg-primary/90
            transition
        ')|trim
    }) %}

    {{ block('button_widget') }}
{%- endblock submit_widget %}

{# =========================
   FILE UPLOAD
========================= #}
{% block file_widget %}
    {% set watermarkValue = attr.watermark|default(false) %}

    <div data-controller="file-upload" class="w-full">

        <label class="
            flex flex-col items-center justify-center
            rounded-lg border-2 border-dashed border-slate-300
            bg-slate-50 px-4 py-6
            text-slate-600
            transition
            hover:border-primary hover:bg-primary/5
            cursor-pointer
        ">

            <div class="text-sm font-medium text-center">
                Glissez-déposez ou cliquez pour sélectionner
            </div>

            {% if watermarkValue %}
                <div class="rounded-md bg-amber-50 px-3 py-2 text-xs text-amber-700 border border-amber-200">
                    Votre document sera automatiquement filigrané à l’envoi
                </div>
            {% endif %}

            <input type="{{ type|default('file') }}"
                   data-file-upload-target="input"
                   class="hidden"
                   {{ block('button_attributes') }}/>

            <div data-file-upload-target="preview" class="mt-3 text-xs text-slate-500"></div>

        </label>

    </div>
{% endblock %}