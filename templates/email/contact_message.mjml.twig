<mjml>
    <mj-head>
        <mj-title>Nouveau message de contact - Loisirs Location</mj-title>
        <mj-preview>Un nouveau message vient d'etre envoye depuis le formulaire de contact.</mj-preview>
        <mj-attributes>
            <mj-all font-family="'Atkinson Hyperlegible', Arial, sans-serif" />
            <mj-text font-size="14px" color="#5a2e15" line-height="1.6" />
            <mj-section padding="20px 0" />
        </mj-attributes>
        <mj-style inline="inline">
            @font-face {
                font-family: 'Custard';
                src: url('https://fonts.cdnfonts.com/css/custard') format('woff2');
                font-weight: normal;
                font-style: normal;
            }
        </mj-style>
    </mj-head>
    <mj-body background-color="#eaccb1">
        <mj-section background-color="#465b32" padding="40px 20px">
            <mj-column>
                <mj-text
                    align="center"
                    color="#ffffff"
                    font-size="32px"
                    font-weight="bold"
                    letter-spacing="2px"
                    font-family="'Custard', serif"
                >
                    🚐 LOISIRS LOCATION
                </mj-text>
                <mj-text
                    align="center"
                    color="#eaccb1"
                    font-size="14px"
                    padding-top="5px"
                >
                    Nouveau message depuis le site
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section background-color="#ffffff" padding="40px 30px">
            <mj-column>
                <mj-text
                    font-size="24px"
                    font-weight="bold"
                    color="#465b32"
                    align="center"
                    line-height="1.3"
                >
                    Nouveau contact recu 📬
                </mj-text>

                <mj-divider
                    border-color="#eaccb1"
                    border-width="2px"
                    padding="22px 0"
                ></mj-divider>

                <mj-text font-weight="bold" color="#465b32" font-size="16px">
                    Informations du contact
                </mj-text>

                <mj-text padding-top="12px" color="#5a2e15">
                    <strong>Nom :</strong> {{ firstName }} {{ lastName }}<br />
                    <strong>Email :</strong> {{ email }}<br />
                    {% if phone %}
                        <strong>Telephone :</strong> {{ phone }}<br />
                    {% endif %}
                    <strong>Date d'envoi :</strong> {{ sentAt|date('d/m/Y a H:i') }}
                </mj-text>

                <mj-divider
                    border-color="#eaccb1"
                    border-width="2px"
                    padding="22px 0"
                ></mj-divider>

                <mj-text font-weight="bold" color="#465b32" font-size="16px">
                    Sujet
                </mj-text>

                <mj-text padding-top="10px" color="#5a2e15">
                    {{ subject }}
                </mj-text>

                <mj-divider
                    border-color="#eaccb1"
                    border-width="2px"
                    padding="22px 0"
                ></mj-divider>

                <mj-text font-weight="bold" color="#465b32" font-size="16px">
                    Message
                </mj-text>

                <mj-text
                    padding-top="12px"
                    color="#5a2e15"
                    background-color="#fff7ef"
                >
                    {{ message|e|nl2br }}
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section background-color="#5a2e15" padding="30px 20px">
            <mj-column>
                <mj-text align="center" color="#eaccb1" font-size="12px">
                    © {{ "now"|date("Y") }} Loisirs Location - Location de
                    vans amenages en Hauts-de-France
                </mj-text>
                <mj-text
                    align="center"
                    color="#eaccb1"
                    font-size="11px"
                    padding-top="10px"
                >
                    Email genere automatiquement depuis le formulaire de contact du site.
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
