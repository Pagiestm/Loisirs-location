<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}Welcome!
			{% endblock %}
		</title>
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Mono:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">
		{% block stylesheets %}
			{{ encore_entry_link_tags('app') }}
		{% endblock %}
        {% block javascripts %}
			{{ encore_entry_script_tags('app') }}
		{% endblock %}
	</head>
	<body
        {{ stimulus_controller('app') }}
        data-app-modal-outlet=".modal-outlet"
    >
		{# Flash messages notifications - Système de pile type Sonner #}
		<div
            {{ stimulus_controller('flashes') }}
            class="fixed top-4 right-4 z-9999 pointer-events-none"
            style="width: 400px; height: 0;"
	    >
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <twig:Flash
                        type="{{ label }}"
                        message="{{ message }}"
                    />
                {% endfor %}
            {% endfor %}
        </div>

		{% block body %}{% endblock %}

		{# Modale de connexion/inscription #}
		{% if not is_granted('IS_AUTHENTICATED_FULLY') %}
			<twig:Modal id="auth" size="sm" initiallyOpen="{{ app.request.query.get('open_login') == 'true' }}">
				<twig:Security:Index
                    loading="lazy"
                    key="auth-component"
                />
			</twig:Modal>
		{% endif %}
	</body>
</html>
