{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe - Loisirs Location{% endblock %}

{% block body %}
    <main class="relative min-h-screen flex flex-col bg-beige pb-16">
        <twig:TextureBackground type="sand" :overlay="0" :intensity="0.18" />

        <section class="relative min-h-70 md:min-h-80 lg:min-h-90 flex items-center justify-center overflow-hidden bg-secondary">
            <div class="absolute inset-0">
                <twig:TextureBackground type="wood" :overlay="0.72" />
            </div>
            <div class="relative z-10 text-center px-4 sm:px-6 max-w-3xl pt-12 sm:pt-20">
                <p class="font-body text-xs uppercase tracking-[0.35em] text-primary mb-4">Espace sécurisé</p>
                <h1 class="font-display text-3xl sm:text-4xl md:text-6xl text-white mb-8 sm:mb-12">Nouveau mot de passe</h1>
            </div>
        </section>

        <section class="max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 relative z-20 -mt-20 sm:-mt-16 lg:-mt-24">
            <div class="bg-white rounded-3xl shadow-2xl shadow-brown/10 overflow-hidden flex flex-col lg:flex-row">
                <div class="bg-linear-to-br from-brown to-brown/90 p-6 sm:p-8 lg:p-12 lg:w-1/3 flex flex-col justify-between text-white">
                    <div>
                        <h2 class="font-display text-2xl sm:text-3xl mb-6">Créer un nouveau mot de passe</h2>
                        <p class="font-body text-white/80 mb-10 leading-relaxed text-sm">
                            Choisissez un mot de passe unique et sécurisé pour protéger votre compte.
                        </p>

                        <div class="space-y-6 sm:space-y-8">
                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center shrink-0 text-primary">
                                    <twig:ux:icon name="lucide:shield-check" class="w-5 h-5" />
                                </div>
                                <div>
                                    <p class="font-body text-xs uppercase tracking-wider text-white/60 mb-1">Sécurité</p>
                                    <p class="font-body text-white text-sm">Le mot de passe doit respecter les règles affichées à droite.</p>
                                </div>
                            </div>

                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center shrink-0 text-primary">
                                    <twig:ux:icon name="lucide:lock-keyhole" class="w-5 h-5" />
                                </div>
                                <div>
                                    <p class="font-body text-xs uppercase tracking-wider text-white/60 mb-1">Compte</p>
                                    <p class="font-body text-white text-sm">Une fois validé, vous pourrez vous connecter normalement.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-12">
                        <a href="{{ path('app_home') }}" class="inline-block text-sm text-white hover:underline">Retour à l'accueil</a>
                    </div>
                </div>

                <div class="p-6 sm:p-8 lg:p-12 lg:w-2/3 bg-white">
                    <h3 class="font-display text-2xl sm:text-3xl text-secondary mb-6 sm:mb-8">Définir votre mot de passe</h3>

                    {{ form_start(form, {
                        'attr': {
                            'class': 'space-y-6',
                            'novalidate': 'novalidate'
                        }
                    }) }}

                    <div>
                        {{ form_row(form.plainPassword.first) }}
                    </div>

                    <div>
                        {{ form_row(form.plainPassword.second) }}
                    </div>

                    <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gray-700">Règles du mot de passe</p>
                        <ul class="mt-3 space-y-1 text-sm text-gray-600">
                            <li>Au moins 8 caractères</li>
                            <li>Une lettre majuscule</li>
                            <li>Une lettre minuscule</li>
                            <li>Un chiffre</li>
                            <li>Un caractère spécial parmi @$!%*?&#</li>
                        </ul>
                    </div>

                    <div class="pt-4 flex justify-end">
                        <twig:Button type="submit" variant="primary" size="md" :loading="true" class="w-full sm:w-auto">
                            Réinitialiser
                        </twig:Button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </section>
    </main>
{% endblock %}