{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - Loisirs Location{% endblock %}

{% block body %}
    <twig:Navbar :heroNav="true" />
    <div class="min-h-screen bg-beige-light flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-md w-full space-y-8">
            <!-- Logo / Title -->
            <div>
                <h1 class="text-center text-4xl font-display font-bold text-secondary mb-2">
                    Mot de passe oublié
                </h1>
                <p class="mt-2 text-center text-sm text-brown-dark">
                    Saisissez votre adresse email pour recevoir un lien de réinitialisation
                </p>
            </div>

            <!-- Flash Messages -->
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="rounded-lg p-4 {% if label == 'success' %}bg-green-50 border border-green-200 text-green-800{% elseif label == 'error' %}bg-red-50 border border-red-200 text-red-800{% else %}bg-blue-50 border border-blue-200 text-blue-800{% endif %}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            <!-- Form -->
            <div class="bg-white rounded-xl shadow-lg p-8">
                {{ form_start(form, {
                    'attr': {
                        'class': 'space-y-6'
                    }
                }) }}

                <div>
                    {{ form_row(form.email) }}
                </div>

                <div>
                    <button
                        type="submit"
                        class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg text-sm font-medium text-white bg-primary hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-all shadow-sm"
                    >
                        Envoyer le lien de réinitialisation
                    </button>
                </div>

                {{ form_end(form) }}

                <!-- Back to Login -->
                <div class="text-center mt-6">
                    <p class="text-sm text-gray-600">
                        Vous vous souvenez de votre mot de passe ?
                        <a href="{{ path('app_home') }}" class="text-primary hover:underline font-medium">
                            Retour à la connexion
                        </a>
                    </p>
                </div>

                <!-- Back to Home -->
                <div class="text-center mt-4">
                    <a href="{{ path('app_home') }}" class="text-sm text-gray-500 hover:text-gray-700">
                        ← Retour à l'accueil
                    </a>
                </div>
            </div>

            <!-- Info Box -->
            <div class="bg-green-dark/10 border border-green-dark/20 rounded-lg p-4 mt-6">
                <p class="text-sm text-brown-dark">
                    <strong>Conseil :</strong> Si vous ne recevez pas l'email dans quelques minutes, vérifiez vos spams ou réessayez avec une autre adresse.
                </p>
            </div>
        </div>
    </div>
    <twig:Footer />
{% endblock %}
