<div {{ attributes }}>
    {% if error %}
        <div class="mb-4 p-4 bg-red-50 border border-red-200 text-red-800 rounded-lg">
            {{ error }}
        </div>
    {% endif %}

    {# Formulaire d'inscription #}
    {{ form_start(form, {
        'attr': {
            'data-action': 'submit->live#action:prevent',
            'data-live-action-param': 'submitRegister',
            'class': 'space-y-4'
        }
    }) }}

        <div class="grid grid-cols-2 gap-4 mb-2">
            <div>
                {{ form_row(form.firstName) }}
            </div>

            <div>
                {{ form_row(form.lastName) }}
            </div>
        </div>

        {{ form_row(form.email) }}

        {{ form_row(form.phone) }}

        <div>
            {{ form_row(form.password) }}
            <p class="text-xs text-gray-500 mt-1">Minimum 8 caractères dont 1 majuscule, 1 minuscule, 1 chiffre et 1 caractère spécial</p>
        </div>

        {{ form_row(form.address) }}

        <div class="grid grid-cols-2 gap-4 mb-0">
            <div>
                {{ form_row(form.postalCode) }}
            </div>

            <div>
                {{ form_row(form.city) }}
            </div>
        </div>

        <div class="mb-8">
            {{ form_row(form.complement) }}
        </div>

        <div class="w-full flex justify-center items-center">
            <twig:Button
                type="submit"
                variant="primary"
                size="md"
                :fullWidth="true"
                attr="data-loading-class='opacity-50 cursor-not-allowed' data-loading-attr='disabled'"
            >Créer mon compte</twig:Button>
        </div>

        <div class="text-center">
            <button
                type="button"
                {{ stimulus_action('security', 'toLogin') }}
                class="text-sm text-primary hover:underline"
            >
                Déjà un compte ? Se connecter
            </button>
        </div>

        <div class="text-center">
            <a href="{{ path('app_home') }}" class="text-sm text-primary hover:underline">
                Retour à l'accueil
            </a>
        </div>

    {{ form_end(form) }}
</div>
