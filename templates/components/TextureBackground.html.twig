{#
  Composant réutilisable : fond texturé généré en CSS/SVG pur (zéro image externe).
  Props :
    type    = 'wood' | 'sand'  (défaut : 'wood')
    overlay = 0.0 → 1.0        (opacité de l'overlay sombre, défaut : 0.72)

  Usage :
    <twig:TextureBackground />
    <twig:TextureBackground type="sand" :overlay="0.6" />
#}
{% set uid = ('tx-' ~ random(99999)) %}

<div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">

    {% if type == 'wood' %}
    {# ── BOIS : grain horizontal avec ondulation organique ── #}
    <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" class="absolute inset-0" style="opacity:{{ intensity }};mix-blend-mode:multiply;">
        <defs>
            <filter id="{{ uid }}" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB">
                {# Turbulence de base — fréquence basse horizontale = veines longues #}
                <feTurbulence
                    type="turbulence"
                    baseFrequency="0.008 0.28"
                    numOctaves="4"
                    seed="7"
                    result="noise"
                />
                {# Ondulation pour casser le côté trop droit #}
                <feDisplacementMap
                    in="SourceGraphic"
                    in2="noise"
                    scale="22"
                    xChannelSelector="R"
                    yChannelSelector="G"
                    result="wave"
                />
                {# Appliquer la turbulence sur un rectangle coloré brun chaud #}
                <feTurbulence
                    type="turbulence"
                    baseFrequency="0.008 0.28"
                    numOctaves="4"
                    seed="7"
                    result="grain"
                />
                {# Coloriser en tons bois (ambre + brun moka) #}
                <feColorMatrix
                    in="grain"
                    type="matrix"
                    values="
                        0.55  0.30  0.05  0  0.22
                        0.28  0.18  0.02  0  0.11
                        0.05  0.03  0.00  0  0.04
                        0     0     0     1  0
                    "
                    result="colored"
                />
                {# Legere saturation / contraste via feComponentTransfer #}
                <feComponentTransfer in="colored">
                    <feFuncR type="gamma" amplitude="1" exponent="0.85" offset="0"/>
                    <feFuncG type="gamma" amplitude="1" exponent="0.9"  offset="0"/>
                    <feFuncB type="gamma" amplitude="1" exponent="1.1"  offset="0"/>
                </feComponentTransfer>
            </filter>
        </defs>
        <rect width="100%" height="100%" filter="url(#{{ uid }})" />
    </svg>

    {% elseif type == 'sand' %}
    {# ── SABLE : dunes (basse fréquence) + grain fin (haute fréquence) fusionnés ── #}
    <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" class="absolute inset-0" style="opacity:{{ intensity }};mix-blend-mode:multiply;">
        <defs>
            <filter id="{{ uid }}" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB">

                {# Couche 1 : grandes ondulations de dunes #}
                <feTurbulence
                    type="turbulence"
                    baseFrequency="0.012 0.045"
                    numOctaves="3"
                    seed="5"
                    result="dunes"
                />

                {# Couche 2 : grain sableux fin #}
                <feTurbulence
                    type="fractalNoise"
                    baseFrequency="0.65 0.80"
                    numOctaves="4"
                    seed="21"
                    result="finegrain"
                />

                {# Mélange des deux couches #}
                <feBlend in="dunes" in2="finegrain" mode="soft-light" result="blended" />

                {# Coloriser : tons sable chaud — beige, or pâle, ocre, crème rosée #}
                <feColorMatrix
                    in="blended"
                    type="matrix"
                    values="
                        0.80  0.45  0.10  0  0.32
                        0.65  0.38  0.08  0  0.26
                        0.25  0.15  0.05  0  0.12
                        0     0     0     1  0
                    "
                    result="colored"
                />

                {# Contraste et chaleur #}
                <feComponentTransfer in="colored">
                    <feFuncR type="gamma" amplitude="1.05" exponent="0.78" offset="0.02"/>
                    <feFuncG type="gamma" amplitude="1.00" exponent="0.82" offset="0.01"/>
                    <feFuncB type="gamma" amplitude="0.90" exponent="1.10" offset="0.00"/>
                </feComponentTransfer>

                {# Légère saturation finale via feColorMatrix saturate #}
                <feColorMatrix type="saturate" values="1.3"/>

            </filter>
        </defs>
        <rect width="100%" height="100%" filter="url(#{{ uid }})" />
    </svg>
    {% endif %}

    {# Overlay sombre pour que le contenu au-dessus reste lisible #}
    <div class="absolute inset-0 bg-secondary" style="opacity: {{ overlay }};"></div>

</div>
