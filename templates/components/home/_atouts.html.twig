<section class="bg-white py-24 px-6" aria-label="Nos engagements">
    <div class="max-w-6xl mx-auto">

        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-24 items-start">

            {# Colonne titre — sticky sur desktop #}
            <div class="md:sticky md:top-24">
                <p class="font-body text-xs font-medium text-brown/40 uppercase tracking-[0.2em] mb-4">Pourquoi nous choisir</p>
                <h2 class="font-display text-5xl md:text-6xl text-secondary leading-tight mb-8">
                    Une location<br>humaine et<br>flexible
                </h2>
                <p class="font-body text-brown/50 text-sm leading-relaxed max-w-xs">
                    Pas d'algorithme, pas de caution en ligne. Juste un contact direct, un van propre, et la route qui s'ouvre devant vous.
                </p>
            </div>

            {# Liste des atouts #}
            <div class="flex flex-col divide-y divide-beige">
                {% set atouts = [
                    {
                        path: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
                        title: 'Flexibilité totale',
                        desc: 'Pas de calendrier public rigide. Chaque location est gérée sur-mesure, selon vos dates et votre projet.'
                    },
                    {
                        path: 'M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z',
                        title: 'Réponse sous 24h',
                        desc: 'Votre demande est traitée rapidement et personnellement. Aucun formulaire perdu dans la nature.'
                    },
                    {
                        path: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
                        title: 'Vans bien entretenus',
                        desc: 'Chaque véhicule est nettoyé et vérifié avant chaque départ. Votre sécurité, notre priorité.'
                    },
                    {
                        path: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
                        title: 'Contact humain',
                        desc: "130+ clients réguliers nous font confiance. Nous privilégions la proximité et l'échange direct."
                    },
                    {
                        path: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z',
                        title: 'Paiement à la remise',
                        desc: 'Aucun paiement en ligne, aucune caution digitale. Tout se règle directement, en toute simplicité.'
                    },
                    {
                        path: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
                        title: 'Données protégées',
                        desc: 'Vos informations personnelles sont stockées de façon sécurisée, dans le respect du RGPD.'
                    },
                ] %}

                {% for atout in atouts %}
                <div class="group flex items-start gap-5 py-6 first:pt-0">
                    <svg class="w-5 h-5 text-secondary/30 mt-0.5 shrink-0 group-hover:text-primary transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="{{ atout.path }}"/>
                    </svg>
                    <div>
                        <h3 class="font-body text-sm font-semibold text-secondary mb-1">{{ atout.title }}</h3>
                        <p class="font-body text-brown/50 text-sm leading-relaxed">{{ atout.desc }}</p>
                    </div>
                </div>
                {% endfor %}
            </div>

        </div>
    </div>
</section>
