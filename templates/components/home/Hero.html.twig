<section
    data-navbar-hero-section
    class="relative h-screen min-h-[640px] flex flex-col items-center justify-center overflow-hidden"
    aria-label="Loisirs Location – Location de vans aménagés en Hauts-de-France"
>
    {# ---- Fond image ---- #}
    <div class="absolute inset-0">
        <twig:Editable:Image
            page="home"
            field="hero_image"
            class="absolute inset-0 w-full h-full object-cover"
        />

        {# Overlay : dégradé brun — fort en haut (navbar) puis vers le bas #}
        <div
            class="absolute inset-0 bg-gradient-to-b from-brown/70 via-brown/40 to-brown/75 pointer-events-none"
            aria-hidden="true"
        ></div>
    </div>

    {# ---- Contenu centré ---- #}
    <div class="relative z-10 text-center px-6 max-w-3xl pt-16 lg:pt-0">
        <twig:Editable:Text page="home" field="hero_subtitle" placeholder="Sous-titre du hero">
            <p class="font-body text-xs uppercase tracking-[0.35em] text-white mb-8">{{ parent() }}</p>
        </twig:Editable:Text>
        <twig:Editable:Text page="home" field="hero_title" placeholder="Titre du hero">
            <h1 class="font-display text-3xl sm:text-5xl md:text-7xl text-white leading-[0.88] mb-8">{{ parent() }}</h1>
        </twig:Editable:Text>
        <twig:Editable:Textarea page="home" field="hero_description" placeholder="Description du hero">
            <p class="font-body text-white text-base md:text-lg max-w-md mx-auto mb-12 leading-relaxed">{{ parent() }}</p>
        </twig:Editable:Textarea>
    </div>

    {# ---- Indicateur de défilement ---- #}
    <div
        class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/40"
        aria-hidden="true"
    >
        <p class="font-body text-[10px] tracking-[0.25em] uppercase">Découvrir</p>
        <twig:ux:icon name="lucide:chevron-down" class="w-4 h-4 animate-bounce" aria-hidden="true" />
    </div>
</section>
