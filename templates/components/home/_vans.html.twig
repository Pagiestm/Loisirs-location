{# ============================================================
   NOS VANS — Grille des véhicules disponibles
   ============================================================ #}
<section class="bg-white py-24 px-6" aria-label="Nos vans aménagés">
    <div class="max-w-6xl mx-auto">

        <div class="mb-16">
            <p class="font-body text-xs font-medium text-brown/40 uppercase tracking-[0.2em] mb-4">À louer</p>
            <h2 class="font-display text-5xl md:text-6xl text-secondary">Nos vans aménagés</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {% set vans = [
                {
                    name: 'Van Compact',
                    sub: 'Idéal couple ou solo',
                    places: '2 – 4 places',
                    couchages: '2 couchages',
                    equip: ['Cuisine équipée', 'Literie fournie', 'Chauffage', 'Prises 220V'],
                    badge: 'Disponible',
                    badge_class: 'bg-secondary/10 text-secondary',
                    photo: 'https://images.unsplash.com/photo-1558981806-ec527fa84c39?w=900&q=80'
                },
                {
                    name: 'Van Familial',
                    sub: 'Idéal famille',
                    places: '4 – 5 places',
                    couchages: '4 couchages',
                    equip: ['Grande cuisine', 'Literie fournie', 'Douche extérieure', 'Rangements XL'],
                    badge: 'Coup de cœur',
                    badge_class: 'bg-primary/10 text-primary',
                    photo: 'https://images.unsplash.com/photo-1533591380348-14193f1de18f?w=900&q=80'
                },
            ] %}

            {% for van in vans %}
            <article class="group flex flex-col bg-beige/20 rounded-2xl overflow-hidden border border-beige hover:border-secondary/20 transition-colors duration-300">

                {# Image / placeholder photo #}
                <div class="relative aspect-[16/9] overflow-hidden bg-beige">
                    <img
                        src="{{ van.photo }}"
                        alt="Photo {{ van.name }}"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                        loading="lazy"
                    >
                    {# Badge #}
                    <span class="absolute top-4 left-4 font-body text-xs px-3 py-1 rounded-full {{ van.badge_class }}">
                        {{ van.badge }}
                    </span>
                </div>

                {# Infos #}
                <div class="p-8 flex flex-col flex-1">
                    <p class="font-body text-xs text-brown/40 mb-2">{{ van.sub }}</p>
                    <h3 class="font-display text-3xl text-secondary mb-5">{{ van.name }}</h3>

                    {# Caractéristiques clés #}
                    <div class="flex items-center gap-6 pb-5 border-b border-beige mb-5">
                        <span class="font-body text-xs text-brown/50 flex items-center gap-1.5">
                            <svg class="w-4 h-4 text-brown/30" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                            </svg>
                            {{ van.places }}
                        </span>
                        <span class="font-body text-xs text-brown/50 flex items-center gap-1.5">
                            <svg class="w-4 h-4 text-brown/30" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
                            </svg>
                            {{ van.couchages }}
                        </span>
                    </div>

                    {# Équipements #}
                    <ul class="grid grid-cols-2 gap-y-2 gap-x-4 mb-8">
                        {% for eq in van.equip %}
                        <li class="flex items-center gap-2 font-body text-xs text-brown/60">
                            <span class="w-1 h-1 rounded-full bg-primary shrink-0" aria-hidden="true"></span>
                            {{ eq }}
                        </li>
                        {% endfor %}
                    </ul>

                    {# CTA texte #}
                    <a
                        href="/devis"
                        class="mt-auto inline-flex items-center gap-2 font-body text-sm font-semibold text-secondary group-hover:text-primary transition-colors duration-200"
                    >
                        Demander un devis
                        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                        </svg>
                    </a>
                </div>

            </article>
            {% endfor %}
        </div>

    </div>
</section>
