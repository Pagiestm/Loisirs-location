<section class="bg-white py-24 px-6" aria-label="Nos engagements">
    <div class="max-w-6xl mx-auto">

        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-24 items-start">

            {# Colonne titre — sticky sur desktop #}
            <div class="md:sticky md:top-24">
                <twig:Editable:Text page="home" field="atouts_subtitle" placeholder="Sous-titre des atouts">
                    <p class="font-body text-xs font-medium text-brown/40 uppercase tracking-[0.2em] mb-4">{{ parent() }}</p>
                </twig:Editable:Text>
                <twig:Editable:Text page="home" field="atouts_title" placeholder="Titre des atouts">
                    <h2 class="font-display text-5xl md:text-6xl text-secondary leading-tight mb-8">{{ parent() }}</h2>
                </twig:Editable:Text>
                <twig:Editable:Textarea page="home" field="atouts_description" placeholder="Description des atouts">
                    <p class="font-body text-brown/50 text-sm leading-relaxed max-w-xs">{{ parent() }}</p>
                </twig:Editable:Textarea>
            </div>

            {# Liste des atouts #}
            <div class="flex flex-col divide-y divide-beige">
                {% set atouts = [
                    {
                        icon: 'lucide:clock',
                        title: 'Flexibilité totale',
                    },
                    {
                        icon: 'lucide:message-circle',
                        title: 'Réponse sous 24h',
                    },
                    {
                        icon: 'lucide:shield-check',
                        title: 'Vans bien entretenus',
                    },
                    {
                        icon: 'lucide:users',
                        title: 'Contact humain',
                    },
                    {
                        icon: 'lucide:credit-card',
                        title: 'Paiement à la remise',
                    },
                    {
                        icon: 'lucide:lock',
                        title: 'Données protégées',
                    },
                ] %}

                {% for atout in atouts %}
                <div class="group flex items-start gap-5 py-6 first:pt-0">
                    <twig:ux:icon
                        name="{{ atout.icon }}"
                        class="w-5 h-5 text-secondary/30 mt-0.5 shrink-0 group-hover:text-primary transition-colors duration-200"
                        aria-hidden="true"
                    />
                    <div>
                        <h3 class="font-body text-sm font-semibold text-secondary mb-1">{{ atout.title }}</h3>
                        <twig:Editable:Textarea
                            page="home"
                            field="atout_desc_{{ loop.index }}"
                            placeholder="Description de l'atout {{ loop.index }}"
                        >
                            <p class="font-body text-brown/50 text-sm leading-relaxed">{{ parent() }}</p>
                        </twig:Editable:Textarea>
                    </div>
                </div>
                {% endfor %}
            </div>

        </div>
    </div>
</section>
