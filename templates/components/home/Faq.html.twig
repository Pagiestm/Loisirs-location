<section class="bg-beige relative overflow-hidden py-8 px-6" aria-label="Questions fréquentes">
    <twig:TextureBackground type="sand" :overlay="0" :intensity="0.18" />
    <div class="max-w-6xl mx-auto relative z-10 grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-24 items-start">

        {# Titre flottant (sticky desktop) #}
        <div class="md:sticky md:top-24">
            <p class="font-body text-xs font-medium text-brown uppercase tracking-[0.2em] mb-4">FAQ</p>
            <twig:Editable:Text page="home" field="faq_title" placeholder="Titre de la FAQ">
                <h2 class="font-display text-5xl md:text-6xl text-secondary leading-tight mb-8">{{ parent() }}</h2>
            </twig:Editable:Text>
            <twig:Editable:Textarea page="home" field="faq_description" placeholder="Description de la FAQ">
                <p class="font-body text-brown text-sm leading-relaxed max-w-xs">{{ parent() }}</p>
            </twig:Editable:Textarea>
        </div>

        {# Accordéon #}
        <div data-controller="faq" class="flex flex-col divide-y divide-brown/10">
            {% set questions = [
                {
                    q: 'Comment réserver un van ?',
                },
                {
                    q: 'Y a-t-il un paiement en ligne ?',
                },
                {
                    q: 'Quels documents faut-il prévoir ?',
                },
                {
                    q: 'Les vans sont-ils bien équipés ?',
                },
                {
                    q: 'Puis-je partir hors des Hauts-de-France ?',
                },
                {
                    q: 'Quelle est la politique d\'annulation ?',
                },
            ] %}

            {% for item in questions %}
            <div class="faq-item group py-6">
                <button
                    data-action="click->faq#toggle"
                    class="w-full flex items-center justify-between gap-6 text-left focus:outline-none cursor-pointer"
                >
                    <span class="font-body text-sm font-semibold text-secondary group-[.faq-open]:text-primary transition-colors duration-200">
                        {{ item.q }}
                    </span>
                    <twig:ux:icon
                        name="lucide:plus"
                        class="w-4 h-4 text-brown shrink-0 transition-transform duration-300 group-[.faq-open]:rotate-45"
                        aria-hidden="true"
                    />
                </button>
                <div class="grid grid-rows-[0fr] transition-all duration-300 ease-in-out group-[.faq-open]:grid-rows-[1fr]">
                    <div class="overflow-y-hidden">
                        <twig:Editable:Textarea
                            page="home"
                            field="faq_answer_{{ loop.index }}"
                            placeholder="Réponse à la question {{ loop.index }}"
                        >
                            <p class="font-body text-sm text-brown leading-relaxed mt-4 max-w-lg">{{ parent() }}</p>
                        </twig:Editable:Textarea>
                    </div>
                </div>
            </div>
            {% endfor %}

        </div>
    </div>
</section>
