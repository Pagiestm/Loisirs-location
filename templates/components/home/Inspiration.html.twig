<section class="bg-secondary relative overflow-hidden py-20" aria-label="Nos inspirations Hauts-de-France">
    <twig:TextureBackground type="wood" :overlay="0.72" />

    <div class="max-w-6xl mx-auto px-6 text-center mb-14 relative z-10">
        <twig:Editable:Text page="home" field="inspiration_subtitle" placeholder="Sous-titre de l'inspiration">
            <p class="font-body text-xs uppercase tracking-[0.35em] text-white mb-4">{{ parent() }}</p>
        </twig:Editable:Text>
        <twig:Editable:Text page="home" field="inspiration_title" placeholder="Titre de l'inspiration">
            <h2 class="font-display text-4xl md:text-5xl text-white">{{ parent() }}</h2>
        </twig:Editable:Text>
    </div>

    {# Ligne 1 — défilement gauche #}
    <div class="relative w-full overflow-hidden mb-4" aria-hidden="true">
        <div class="flex w-max animate-marquee">
            {% set places1 = [
                'Baie de Somme', 'Côte d\'Opale', 'Cap Gris-Nez', 'Forêt de Crécy',
                'Dunes de Slack', 'Cap Blanc-Nez', 'Vallée de la Canche', 'Monts des Flandres'
            ] %}
            <div class="flex shrink-0 items-center gap-10 pr-10">
                {% for place in places1 %}
                <span class="font-display text-2xl text-white/25 whitespace-nowrap select-none">{{ place }}</span>
                {% endfor %}
            </div>
            <div class="flex shrink-0 items-center gap-10 pr-10">
                {% for place in places1 %}
                <span class="font-display text-2xl text-white/25 whitespace-nowrap select-none">{{ place }}</span>
                {% endfor %}
            </div>
        </div>
    </div>

    {# Ligne 2 — défilement droite (sens inverse) #}
    <div class="relative w-full overflow-hidden" aria-hidden="true">
        <div class="flex w-max animate-marquee-reverse">
            {% set places2 = [
                'Bivouac au bord de l\'eau', 'Lever de soleil sur les dunes', 'Feu de camp',
                'Route des Flandres', 'Étangs de la Sensée', 'Réserve naturelle de l\'Authie',
                'Falaises de Boulogne', 'Repas au coucher du soleil'
            ] %}
            <div class="flex shrink-0 items-center gap-10 pr-10">
                {% for place in places2 %}
                <span class="font-display text-xl text-white/15 whitespace-nowrap select-none">{{ place }}</span>
                {% endfor %}
            </div>
            <div class="flex shrink-0 items-center gap-10 pr-10">
                {% for place in places2 %}
                <span class="font-display text-xl text-white/15 whitespace-nowrap select-none">{{ place }}</span>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="max-w-6xl mx-auto px-6 text-center mt-14 relative z-10">
        <twig:Editable:Textarea page="home" field="inspiration_description" placeholder="Description de l'inspiration">
            <p class="font-body text-white/70 text-sm max-w-sm mx-auto leading-relaxed">{{ parent() }}</p>
        </twig:Editable:Textarea>
    </div>

</section>
