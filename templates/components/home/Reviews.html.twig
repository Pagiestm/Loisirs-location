<section class="bg-beige py-8 px-6" aria-label="Avis clients">
    <div class="max-w-6xl mx-auto">

        {# ── En-tête ── #}
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
            <div>
                <p class="font-body text-xs font-medium text-brown/40 uppercase tracking-[0.2em] mb-4">Témoignages</p>
                <h2 class="font-display text-5xl md:text-6xl text-secondary">Ce qu'ils en disent</h2>
            </div>
            <div class="flex flex-col items-start md:items-end gap-3 pb-1">
                {# Note globale dynamique #}
                <div class="flex items-center gap-2">
                    <div class="flex gap-0.5">
                        {% set globalRating = placeData.rating ?? 0 %}
                        {% for i in 1..5 %}
                            <twig:ux:icon name="lucide:star" class="w-4 h-4 {{ i <= globalRating ? 'text-primary' : 'text-brown/20' }} [&_*]:fill-current [&_*]:stroke-0" aria-hidden="true" />
                        {% endfor %}
                    </div>
                    <span class="font-body text-sm font-semibold text-secondary">
                        {{ globalRating > 0 ? globalRating : '5' }}/5
                    </span>
                    <span class="font-body text-xs text-brown/40">
                        · {{ placeData.count ?? 0 }} avis Google
                    </span>
                </div>
                {# Lien vers les avis Google #}
                {% if placeData.mapsUrl is defined and placeData.mapsUrl %}
                    <a
                        href="{{ placeData.mapsUrl }}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 font-body text-xs text-brown/50 hover:text-secondary transition-colors duration-200"
                    >
                        <twig:ux:icon name="simple-icons:google" class="w-3.5 h-3.5" aria-hidden="true" />
                        Voir tous les avis sur Google
                        <twig:ux:icon name="lucide:external-link" class="w-3 h-3" aria-hidden="true" />
                    </a>
                {% endif %}
            </div>
        </div>

        {# ── Carousel ── #}
        <div data-controller="reviews" class="relative">
            {# Track scrollable #}
            <div
                data-reviews-target="track"
                class="flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-4 scrollbar-none"
                style="-ms-overflow-style: none; scrollbar-width: none;"
            >
                {% for item in placeData.reviews ?? [] %}
                <blockquote
                    data-reviews-card
                    class="snap-start shrink-0 w-[min(320px,85vw)] bg-white rounded-2xl p-8 flex flex-col gap-5"
                >
                    {# Étoiles #}
                    <div class="flex gap-0.5" aria-label="{{ item.note }} étoiles sur 5">
                        {% for i in 1..5 %}
                        <twig:ux:icon name="lucide:star" class="w-4 h-4 {{ i <= item.note ? 'text-primary' : 'text-brown/20' }} [&_*]:fill-current [&_*]:stroke-0" aria-hidden="true" />
                        {% endfor %}
                    </div>

                    {# Texte #}
                    <p class="font-body text-brown/70 text-sm leading-relaxed flex-1">{{ item.texte }}</p>

                    {# Auteur #}
                    <footer class="flex items-center gap-3 pt-4 border-t border-beige">
                        <div class="w-8 h-8 rounded-full bg-secondary/10 flex items-center justify-center shrink-0">
                            <span class="font-display text-secondary text-sm leading-none">{{ item.initiale }}</span>
                        </div>
                        <div class="flex flex-col min-w-0">
                            <span class="font-body text-secondary text-sm font-semibold truncate">{{ item.nom }}</span>
                            {% if item.date is defined and item.date %}
                                <span class="font-body text-brown/40 text-xs">{{ item.date }}</span>
                            {% endif %}
                        </div>
                        <twig:ux:icon name="simple-icons:google" class="w-4 h-4 ml-auto text-brown/30 shrink-0" aria-hidden="true" />
                    </footer>
                </blockquote>
                {% endfor %}
            </div>

            {# Boutons prev / next #}
            <div class="flex items-center justify-end gap-3 mt-6">
                <button
                    data-reviews-target="prev"
                    data-action="click->reviews#prev"
                    class="w-10 h-10 rounded-full border border-brown/20 flex items-center justify-center text-secondary hover:border-secondary hover:bg-secondary hover:text-white transition-all duration-200 disabled:opacity-30 disabled:pointer-events-none"
                    aria-label="Avis précédents"
                >
                    <twig:ux:icon name="lucide:chevron-left" class="w-4 h-4" aria-hidden="true" />
                </button>
                <button
                    data-reviews-target="next"
                    data-action="click->reviews#next"
                    class="w-10 h-10 rounded-full border border-brown/20 flex items-center justify-center text-secondary hover:border-secondary hover:bg-secondary hover:text-white transition-all duration-200 disabled:opacity-30 disabled:pointer-events-none"
                    aria-label="Avis suivants"
                >
                    <twig:ux:icon name="lucide:chevron-right" class="w-4 h-4" aria-hidden="true" />
                </button>
            </div>
        </div>

    </div>
</section>
