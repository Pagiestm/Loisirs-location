<div class="bg-secondary" aria-label="Nos engagements">
    <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-white/10">

            {% set items = [
                {
                    icon: 'lucide:circle-check',
                },
                {
                    icon: 'lucide:clock',
                },
                {
                    icon: 'lucide:key-round',
                },
            ] %}

            {% for item in items %}
            <div class="flex items-center gap-4 px-0 md:px-8 py-5 first:pl-0 last:pr-0">
                <twig:ux:icon
                    name="{{ item.icon }}"
                    class="w-5 h-5 text-primary shrink-0"
                    aria-hidden="true"
                />
                <div>
                    <twig:Editable:Text
                        page="home"
                        field="reassurance_label_{{ loop.index }}"
                        placeholder="Label de l'engagement {{ loop.index }}"
                    >
                        <p class="font-body text-sm font-semibold text-white leading-snug">{{ parent() }}</p>
                    </twig:Editable:Text>
                    <twig:Editable:Textarea
                        page="home"
                        field="reassurance_desc_{{ loop.index }}"
                        placeholder="Description de l'engagement {{ loop.index }}"
                    >
                        <p class="font-body text-xs text-white/40 mt-0.5">{{ parent() }}</p>
                    </twig:Editable:Textarea>
                </div>
            </div>
            {% endfor %}

        </div>
    </div>
</div>
