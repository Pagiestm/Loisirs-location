<section class="bg-white border-t border-beige py-24 px-6" aria-label="Demander un devis">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-24 items-center">

        {# Texte #}
        <div>
            <twig:Editable:Text page="home" field="cta_subtitle" placeholder="Sous-titre du bandeau CTA">
                <p class="font-body text-xs font-medium text-brown/40 uppercase tracking-[0.2em] mb-4">
                    {{ parent() }}
                </p>
            </twig:Editable:Text>
            <twig:Editable:Text page="home" field="cta_title" placeholder="Titre du bandeau CTA">
                <h2 class="font-display text-5xl md:text-6xl text-secondary leading-tight mb-6">
                    {{ parent() }}
                </h2>
            </twig:Editable:Text>
            <twig:Editable:Textarea page="home" field="cta_description" placeholder="Description du bandeau CTA">
                <p class="font-body text-brown/50 text-sm leading-relaxed max-w-xs">
                    {{ parent() }}
                </p>
            </twig:Editable:Textarea>
        </div>

        {# CTA + détails #}
        <div class="flex flex-col gap-6">
            <twig:Button href="/devis" variant="primary" size="lg" icon="arrow-right">
                Demander un devis
            </twig:Button>
            <ul class="flex flex-col gap-3">
                {% set points = [
                    'Réponse personnalisée sous 24h',
                    'Aucun paiement en ligne requis',
                    'Contrat signé à la remise des clés',
                ] %}
                {% for point in points %}
                <li class="flex items-center gap-3 font-body text-sm text-brown/50">
                    <span class="w-1 h-1 rounded-full bg-primary shrink-0" aria-hidden="true"></span>
                    {{ point }}
                </li>
                {% endfor %}
            </ul>
        </div>

    </div>
</section>
