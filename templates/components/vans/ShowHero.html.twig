<section
	class="bg-secondary relative overflow-hidden pt-36 pb-0 px-6">
	<twig:TextureBackground type="wood" :overlay="0.72" />

	<div
		class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-end relative">

		{# ── Texte ── #}
		<div
			class="pb-6 sm:pb-20 ">
			{# Retour #}
			<a href="{{ path('app_vans_index') }}" class="inline-flex items-center gap-2 font-body text-xs text-white hover:text-white/60 transition-colors duration-200 mb-10 group">
				<twig:ux:icon name="lucide:arrow-left" class="w-3.5 h-3.5 group-hover:-translate-x-0.5 transition-transform duration-200" aria-hidden="true"/>
				Tous les vans
			</a>

			<p class="font-body text-xs uppercase tracking-[0.3em] text-primary mb-3">{{ van.subtitle }}</p>
			<h1 class="font-display text-7xl md:text-9xl text-white leading-none mb-8">{{ van.name }}</h1>

			{% if van.description %}
				<p class="font-body text-white text-sm leading-relaxed max-w-sm mb-10">
					{{ van.description }}
				</p>
			{% endif %}

			<twig:Button label="Demander un devis" href="{{ path('app_home') }}#devis" variant="primary" size="lg" icon="arrow-right"/>
		</div>

		{# ── Image ── #}
		<div class="relative self-end overflow-hidden rounded-t-3xl">
			<img src="{{ van.image }}" alt="{{ van.name }}" class="w-full max-h-[560px] object-cover object-center">
		</div>

	</div>
</section>
