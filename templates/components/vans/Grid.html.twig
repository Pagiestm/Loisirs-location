<section class="bg-beige relative overflow-hidden py-20 px-6" aria-label="Liste des vans">
    <twig:TextureBackground type="sand" :overlay="0" :intensity="0.18" />
    <div class="max-w-6xl mx-auto relative z-10">
        {% if vans is empty %}
            <div class="flex flex-col items-center justify-center py-28 gap-4">
                <twig:ux:icon name="lucide:search-x" class="w-10 h-10 text-brown" aria-hidden="true" />
                <p class="font-body text-brown text-sm">Aucun van disponible pour le moment.</p>
            </div>
        {% else %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {% for van in vans %}
                    <twig:Vans:Card :van="van" />
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
