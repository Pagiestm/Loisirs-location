<section class="bg-secondary relative overflow-hidden h-screen min-h-160 flex flex-col justify-center px-6">
	<twig:TextureBackground type="wood" :overlay="0.72" />

	<div class="max-w-6xl w-full mx-auto relative flex items-center gap-12">
		{# Texte à gauche #}
		<div class="flex-1">
			<p class="font-body text-xs uppercase tracking-[0.3em] text-white mb-5">Actualités & Conseils</p>
			<h1 class="font-display text-6xl md:text-8xl text-white leading-none mb-8">
				Notre Blog
			</h1>
			<p class="font-body text-white text-sm max-w-sm leading-relaxed mb-10">
				Découvrez nos conseils, astuces et actualités pour profiter au maximum de vos aventures en van.
			</p>

			{% if count > 0 %}
				<div class="inline-flex items-center gap-3 bg-white/5 border border-white/10 rounded-full px-5 py-2.5">
					<span class="w-2 h-2 rounded-full bg-primary animate-pulse shrink-0" aria-hidden="true"></span>
					<span class="font-body text-xs text-white">{{ count }} article{{ count > 1 ? 's' : '' }} publié{{ count > 1 ? 's' : '' }}</span>
				</div>
			{% endif %}
		</div>

		{# Image à droite #}
		<div class="hidden lg:block flex-1 relative">
			<img src="/images/Nos-vans.jpg" alt="Blog Loisirs Location" class="w-full h-80 object-cover rounded-2xl shadow-2xl">
		</div>
	</div>
</section>
