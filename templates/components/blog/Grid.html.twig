<section class="relative py-24 px-6" aria-label="Articles de blog">
	<twig:TextureBackground type="sand" :overlay="0" :intensity="0.18" />
	<div class="relative z-10 max-w-6xl mx-auto">

		{% if posts is empty %}
			{# État vide #}
			<div class="flex flex-col items-center justify-center py-28 gap-4">
                <twig:ux:icon name="lucide:search-x" class="w-10 h-10 text-brown" aria-hidden="true" />
                <p class="font-body text-brown text-sm">Aucun article pour le moment.</p>
				<p class="font-body text-sm text-brown/60 leading-relaxed">
					Revenez bientôt pour découvrir nos derniers articles, conseils et actualités sur la location de vans aménagés.
				</p>
            </div>
		{% else %}
			{# Grille d'articles #}
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{% for post in posts %}
					<twig:Blog:Card :post="post" />
				{% endfor %}
			</div>
		{% endif %}

	</div>
</section>
