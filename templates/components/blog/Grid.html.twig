<section class="relative py-24 px-6" aria-label="Articles de blog">
	<twig:TextureBackground type="sand" :overlay="0" :intensity="0.18" />
	<div class="relative z-10 max-w-6xl mx-auto">

		{% if posts is empty %}
			{# État vide #}
			<div class="text-center py-16">
				<div class="w-24 h-24 mx-auto mb-6 rounded-2xl bg-beige flex items-center justify-center">
					<twig:ux:icon name="lucide:newspaper" class="w-12 h-12 text-brown/30" aria-hidden="true" />
				</div>
				<h2 class="font-display text-3xl text-secondary mb-3">Aucun article pour le moment</h2>
				<p class="font-body text-sm text-brown/60 max-w-md mx-auto leading-relaxed">
					Revenez bientôt pour découvrir nos derniers articles, conseils et actualités sur la location de vans aménagés.
				</p>
			</div>
		{% else %}
			{# Grille d'articles #}
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{% for post in posts %}
					<twig:Blog:Card :post="post" />
				{% endfor %}
			</div>
		{% endif %}

	</div>
</section>
