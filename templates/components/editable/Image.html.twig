{% set placeholder_src = 'https://placehold.co/800x450?text=Image' %}
{% set display_src = src is not empty ? src : placeholder_src %}

<div {{ attributes }} class="block h-full w-full">

    {% if edit is true and app.user is defined and app.user.isAdmin is true %}
        <twig:ContextMenu class="h-full w-full">
            <twig:block name="trigger">
                <img
                    src="{{ display_src }}"
                    alt="{{ alt }}"
                    class="{{ class }}"
                />
            </twig:block>

            <twig:block name="content">
                <div class="p-3 space-y-3 text-left">

                    {# — Champ fichier — #}
                    <div>
                        <label class="block text-xs font-medium text-gray-700 mb-1.5">
                            Image
                        </label>
                        <input
                            type="file"
                            name="image_file"
                            accept="image/*"
                            class="w-80 text-sm text-gray-700
                                   file:mr-3 file:py-1.5 file:px-3
                                   file:rounded-md file:border-0
                                   file:text-sm file:font-medium
                                   file:bg-blue-50 file:text-blue-700
                                   hover:file:bg-blue-100"
                        />
                        {# Aperçu du chemin actuel #}
                        {% if src is not empty %}
                            <p class="mt-1 text-xs text-gray-400 truncate w-80">
                                {{ src }}
                            </p>
                        {% endif %}
                    </div>

                    {# — Champ alt — #}
                    <div>
                        <label
                            for="edit-alt-{{ field }}"
                            class="block text-xs font-medium text-gray-700 mb-1.5"
                        >
                            Texte alternatif (alt)
                        </label>
                        <input
                            id="edit-alt-{{ field }}"
                            type="text"
                            data-model="norender|alt"
                            value="{{ alt }}"
                            placeholder="Description de l'image…"
                            class="w-80 px-3 py-2 text-sm bg-white text-gray-900
                                    border border-gray-300 rounded-md
                                    focus:outline-none focus:ring-2
                                    focus:ring-blue-500 focus:border-transparent"
                        />
                    </div>

                    {# — Bouton enregistrer — #}
                    <button
                        type="button"
                        data-action="live#action"
                        data-live-action-param="files(image_file)|saveImage"
                        class="w-full flex items-center justify-center gap-2 px-3 py-2
                                text-sm font-medium text-white bg-blue-600 rounded-md
                                hover:bg-blue-700 focus:outline-none focus:ring-2
                                focus:ring-blue-500 focus:ring-offset-2 transition-colors"
                    >
                        <span data-loading="action(saveImage)|show">
                            {{ ux_icon('lucide:loader', {class: 'w-4 h-4 animate-spin'}) }}
                        </span>
                        <span data-loading="action(saveImage)|hide">
                            {{ ux_icon('lucide:check', {class: 'w-4 h-4'}) }}
                        </span>
                        <span>Enregistrer</span>
                    </button>

                </div>
            </twig:block>
        </twig:ContextMenu>

    {% else %}
        <img
            src="{{ display_src }}"
            alt="{{ alt }}"
            class="{{ class }}"
        />
    {% endif %}

</div>
