<div {{ attributes }} class="block">
    {% set content %}
        {% block content %}
            {% if items is empty %}
                {{ placeholder }}
            {% else %}
                {% block list %}
                    <ul>
                        {% for item in items %}
                            {% block item %}
                                <li>{{ item }}</li>
                            {% endblock %}
                        {% endfor %}
                    </ul>
                {% endblock %}
            {% endif %}
        {% endblock %}
    {% endset %}

    {% if edit is true and app.user is defined and app.user.isAdmin is true %}
        <twig:ContextMenu>
            <twig:block name="trigger">
                {{ content|raw }}
            </twig:block>
            <twig:block name="content">
                <div class="p-3 space-y-3 text-left" data-loading="addClass(animate-pulse)">
                    <div>
                        <label class="block text-xs font-medium text-gray-700 mb-1.5">
                            Liste
                        </label>

                        <div class="space-y-2 w-80">
                            {% for index, item in items %}
                                <div class="flex items-center gap-2">
                                    <span class="text-gray-400 text-xs">•</span>
                                    <input
                                        type="text"
                                        data-model="norender|items[{{ index }}]"
                                        value="{{ item }}"
                                        placeholder="{{ placeholder ?: 'Élément ' ~ (index + 1) }}"
                                        {{ stimulus_target('context-menu', 'input') }}
                                        class="flex-1 px-3 py-2 text-sm bg-white text-gray-900 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                    >
                                    {% if items|length > 1 %}
                                        <button
                                            type="button"
                                            data-action="live#action"
                                            data-live-action-param="removeItem"
                                            data-live-index-param="{{ index }}"
                                            class="text-gray-400 hover:text-red-500 transition-colors"
                                        >
                                            {{ ux_icon('lucide:x', {class: 'w-4 h-4'}) }}
                                        </button>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>

                        <button
                            type="button"
                            data-action="live#action"
                            data-live-action-param="addItem"
                            class="mt-2 flex items-center gap-1.5 text-xs text-blue-600 hover:text-blue-700 transition-colors"
                        >
                            {{ ux_icon('lucide:plus', {class: 'w-3.5 h-3.5'}) }}
                            Ajouter un élément
                        </button>
                    </div>

                    <button
                        type="button"
                        data-action="live#action"
                        data-live-action-param="saveContent"
                        class="w-full flex items-center justify-center gap-2 px-3 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors"
                    >
                        <span data-loading="action(saveContent)|show">{{ ux_icon('lucide:loader', {class: 'w-4 h-4 animate-spin'}) }}</span>
                        <span data-loading="action(saveContent)|hide">{{ ux_icon('lucide:check', {class: 'w-4 h-4'}) }}</span>
                        <span>Enregistrer</span>
                    </button>
                </div>
            </twig:block>
        </twig:ContextMenu>
    {% else %}
        {{ content|raw }}
    {% endif %}
</div>
