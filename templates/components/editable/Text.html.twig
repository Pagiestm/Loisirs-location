<div {{ attributes }} class="block">
    {% set content %}
        {% block content %}{{ value is empty ? placeholder : value|raw }}{% endblock %}
    {% endset %}

    {% if edit is true and app.user is defined and app.user.isAdmin is true %}
        <twig:ContextMenu>
            <twig:block name="trigger">
                {{ content|raw }}
            </twig:block>
            <twig:block name="content">
                <div class="p-3 space-y-3 text-left">
                    <div>
                        <label for="edit-{{ field }}" class="block text-xs font-medium text-gray-700 mb-1.5">
                            Contenu
                        </label>
                        <input
                            id="edit-{{ field }}"
                            type="text"
                            data-model="norender|value"
                            value="{{ value }}"
                            placeholder="{{ placeholder }}"
                            {{ stimulus_target('context-menu', 'input') }}
                            class="w-full px-3 py-2 text-sm bg-white text-gray-900 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                        >
                    </div>
                    <button
                        type="button"
                        data-action="live#action"
                        data-live-action-param="saveContent"
                        class="w-full flex items-center justify-center gap-2 px-3 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors"
                    >
                        <span data-loading="action(saveContent)|show">{{ ux_icon('lucide:loader', {class: 'w-4 h-4 animate-spin'}) }}</span>
                        <span data-loading="action(saveContent)|hide">{{ ux_icon('lucide:check', {class: 'w-4 h-4'}) }}</span>
                        <span>Enregistrer</span>
                    </button>
                </div>
            </twig:block>
        </twig:ContextMenu>
    {% else %}
        {{ content|raw }}
    {% endif %}
</div>
