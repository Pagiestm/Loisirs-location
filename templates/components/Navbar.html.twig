<header
    data-controller="navbar"
    data-navbar-hero-value="{{ heroNav ? 'true' : 'false' }}"
    class="fixed top-0 left-0 right-0 z-50 transition-[background-color,box-shadow,transform] duration-300 ease-in-out {{ heroNav ? 'bg-transparent' : 'bg-secondary shadow-lg' }}"
>
    {# ── Backdrop (clic pour fermer) ── #}
    <div
        data-navbar-target="backdrop"
        data-action="click->navbar#closeMenu"
        class="fixed inset-0 z-20 bg-black/60 opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out"
        aria-hidden="true"
    ></div>

    {# ── Barre principale ── #}
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

        {# Logo #}
        <a href="{{ path('app_home') }}" class="flex items-center gap-3 group" aria-label="Retour à l'accueil">
            <span class="text-primary text-3xl font-display leading-none">LL</span>
            <div class="flex flex-col leading-tight">
                <span class="text-white font-display text-lg tracking-wide">Loisirs Location</span>
                <span class="text-beige text-xs font-body opacity-80">Location de vans aménagés</span>
            </div>
        </a>

        {# Nav desktop #}
        <nav aria-label="Navigation principale">
            <ul class="hidden lg:flex items-center gap-8 font-body text-sm font-medium">
                <li>
                    <a href="{{ path('app_home') }}"
                       class="{{ activePage == 'home' ? 'text-primary border-b-2 border-primary pb-0.5' : 'text-white hover:text-primary' }} transition-colors duration-200">
                        Accueil
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_vans_index') }}"
                       class="{{ activePage == 'vans' ? 'text-primary border-b-2 border-primary pb-0.5' : 'text-white hover:text-primary' }} transition-colors duration-200">
                        Nos vans
                    </a>
                </li>
                <li>
                    <a href="#"
                       class="{{ activePage == 'contact' ? 'text-primary border-b-2 border-primary pb-0.5' : 'text-white hover:text-primary' }} transition-colors duration-200">
                        Contact
                    </a>
                </li>
                <li>
                    <twig:Button label="Demander un devis" href="#devis" variant="primary" size="sm" />
                </li>
            </ul>
        </nav>

        {# Burger menu mobile #}
        <button
            data-navbar-target="burger"
            class="lg:hidden relative z-10 flex flex-col justify-center gap-1.5 p-2 text-white w-10 h-10"
            aria-label="Ouvrir le menu"
            aria-expanded="false"
            data-action="click->navbar#toggleMenu"
        >
            <span data-navbar-target="line1" class="block w-6 h-0.5 bg-current origin-center transition-all duration-300"></span>
            <span data-navbar-target="line2" class="block w-6 h-0.5 bg-current transition-all duration-300"></span>
            <span data-navbar-target="line3" class="block w-6 h-0.5 bg-current origin-center transition-all duration-300"></span>
        </button>
    </div>

    {# ── Drawer sidebar (gauche → droite) ── #}
    <div
        data-navbar-target="menu"
        class="fixed inset-y-0 right-0 z-30 w-72 bg-secondary translate-x-full transition-transform duration-300 ease-in-out flex flex-col pt-24 px-8 pb-8 lg:hidden"
        aria-label="Menu mobile"
        aria-hidden="true"
    >
        {# Bouton fermer #}
        <button
            class="absolute top-5 right-5 text-white/60 hover:text-white transition-colors p-2"
            aria-label="Fermer le menu"
            data-action="click->navbar#closeMenu"
        >
            <twig:ux:icon name="lucide:x" class="w-5 h-5" aria-hidden="true" />
        </button>

        {# Logo dans le drawer #}
        <div class="mb-10">
            <span class="text-primary text-2xl font-display">Loisirs Location</span>
            <p class="text-beige/70 text-xs font-body mt-1">Location de vans aménagés</p>
        </div>

        {# Liens #}
        <nav aria-label="Menu mobile">
            <ul class="flex flex-col gap-1 font-body text-base">
                <li>
                    <a href="{{ path('app_home') }}"
                       class="{{ activePage == 'home' ? 'text-primary' : 'text-white/80 hover:text-white' }} block py-3 border-b border-white/10 transition-colors duration-200">
                        Accueil
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_vans_index') }}"
                       class="{{ activePage == 'vans' ? 'text-primary' : 'text-white/80 hover:text-white' }} block py-3 border-b border-white/10 transition-colors duration-200">
                        Nos vans
                    </a>
                </li>
                <li>
                    <a href="#"
                       class="{{ activePage == 'contact' ? 'text-primary' : 'text-white/80 hover:text-white' }} block py-3 border-b border-white/10 transition-colors duration-200">
                        Contact
                    </a>
                </li>
            </ul>
        </nav>

        {# CTA #}
        <div class="mt-auto">
            <twig:Button label="Demander un devis" href="#devis" variant="primary" size="md" :fullWidth="true" />
        </div>
    </div>
</header>
