{# templates/admin/fields/quote_response_values.html.twig #}
<div class="table-responsive">
    <table class="table table-bordered table-striped mb-0">
        <tbody>
        {% for responseValue in field.value %}
            <tr>
                <th class="w-25 text-muted bg-light align-middle" style="min-width: 200px;">
                    {{ responseValue.field.options.label|default('Champ') }}
                </th>
                <td class="align-middle">
                    {% if responseValue.value %}
                        {% if responseValue.field.type.value == 'file' %}
                            {% set fileUrl = vich_uploader_asset(responseValue, 'documentFile') %}
                            {% set extension = responseValue.value|split('.')|last|lower %}
                            {% set isImage = extension in ['jpg', 'jpeg', 'png', 'webp', 'gif'] %}

                            <div class="d-flex gap-2">
                                <a href="#" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#fileModal-{{ responseValue.id }}">
                                    <i class="fa {% if isImage %}fa-image{% else %}fa-file-pdf-o{% endif %}"></i> Voir le document
                                </a>
                                <a href="{{ fileUrl }}" download="{{ responseValue.value }}" class="btn btn-sm btn-outline-secondary">
                                    <i class="fa fa-download"></i> Télécharger
                                </a>
                            </div>

                            <!-- Modal -->
                            <div class="modal fade" id="fileModal-{{ responseValue.id }}" tabindex="-1" aria-labelledby="fileModalLabel-{{ responseValue.id }}" aria-hidden="true">
                                <div class="modal-dialog modal-xl modal-dialog-centered">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="fileModalLabel-{{ responseValue.id }}">Document : {{ responseValue.value }}</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body p-0 bg-light d-flex justify-content-center align-items-center" style="height: 80vh;">
                                            {% if isImage %}
                                                <img src="{{ fileUrl }}" alt="{{ responseValue.value }}" style="max-height: 100%; max-width: 100%; object-fit: contain; padding: 1rem;">
                                            {% else %}
                                                <iframe src="{{ fileUrl }}" width="100%" height="100%" style="border: none;"></iframe>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <span class="fw-medium">{{ responseValue.value }}</span>
                        {% endif %}
                    {% else %}
                        <span class="text-muted fst-italic">Non renseigné</span>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="2">
                    <div class="alert alert-secondary mb-0" role="alert">
                        <i class="fa fa-info-circle me-2"></i> Aucune réponse pour ce devis.
                    </div>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
